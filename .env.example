# Copy this file to .env and fill in real values.
# Base URL of the backend API (used by src/api/apiClient.js).
VITE_API_BASE_URL=https://api.esmlimo.com

# The staff dashboard (/admin) answers from built-in demo data until this is
# "false". Set it to "false" once the backend implements docs/admin-api.md.
VITE_ADMIN_MOCK=true

# The public website (everything outside /admin) answers from the demo data in
# src/data until this is "false". Set it to "false" once the backend is up.
VITE_API_MOCK=true
